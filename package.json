{
  "name": "aura-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Aura — your intent, in motion.",
  "author": "Aura",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "vite build",
    "package": "npm run build && electron-builder --win portable",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.2",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.8",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.aura.desktop",
    "productName": "Aura",
    "compression": "store",
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "portable"
    }
  }
}
